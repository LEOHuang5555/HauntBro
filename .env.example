# HauntBro Environment Configuration
# Copy this file to .env and fill in your actual values
# DO NOT commit .env files to version control

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
DATABASE_URL=postgresql+psycopg2://username:password@localhost/database_name

# For cloud deployment (example)
# DATABASE_URL=postgresql://user:pass@host:5432/dbname?sslmode=require

# Database connection settings
DATABASE_DEBUG=false
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10

# =============================================================================
# REDDIT API CREDENTIALS
# =============================================================================
# Get these from https://www.reddit.com/prefs/apps
REDDIT_CLIENT_ID=your_reddit_client_id_here
REDDIT_CLIENT_SECRET=your_reddit_client_secret_here
REDDIT_USER_AGENT=YourAppName:1.0.0 (by /u/yourusername)

# =============================================================================
# JWT AUTHENTICATION
# =============================================================================
# Generate a secure secret key for JWT tokens
JWT_SECRET_KEY=your_super_secure_secret_key_here_min_32_chars
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# =============================================================================
# APPLICATION SETTINGS
# =============================================================================
# Environment (development, staging, production)
ENVIRONMENT=development

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_DEBUG=true

# CORS Settings (comma-separated URLs)
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# =============================================================================
# SCRAPING CONFIGURATION
# =============================================================================
# Reddit API rate limiting and delays
REDDIT_RATE_LIMIT_DELAY=0.1
REDDIT_BATCH_DELAY=2
REDDIT_MAX_RETRIES=3

# PTT scraping settings
PTT_REQUEST_DELAY=1.0
PTT_MAX_RETRIES=3

# Content processing
MIN_CONTENT_LENGTH=200
MAX_CONTENT_LENGTH=50000
CHUNK_SIZE=1000

# =============================================================================
# LOGGING CONFIGURATION
# =============================================================================
LOG_LEVEL=INFO
LOG_FILE_PATH=logs/hauntbro.log
LOG_MAX_FILE_SIZE=10485760  # 10MB
LOG_BACKUP_COUNT=5

# =============================================================================
# CLOUD DEPLOYMENT (Optional)
# =============================================================================
# AWS Settings
# AWS_ACCESS_KEY_ID=your_aws_access_key
# AWS_SECRET_ACCESS_KEY=your_aws_secret_key
# AWS_REGION=us-east-1
# S3_BUCKET_NAME=your-bucket-name

# Redis (for caching/sessions)
# REDIS_URL=redis://localhost:6379/0

# Kafka (for streaming updates)
# KAFKA_BOOTSTRAP_SERVERS=localhost:9092
# KAFKA_NEW_POSTS_TOPIC=hauntbro-new-posts
# KAFKA_STATUS_TOPIC=hauntbro-processing-status

# Historical collection settings
HISTORICAL_START_YEAR=2020
HISTORICAL_GRANULARITY=quarter
HISTORICAL_BATCH_SIZE=500

# =============================================================================
# SECURITY SETTINGS
# =============================================================================
# Password hashing
BCRYPT_ROUNDS=12

# Session security
SESSION_SECRET_KEY=another_secure_secret_key_for_sessions

# API Rate limiting
API_RATE_LIMIT=100  # requests per minute per IP

# Test/Development settings
TEST_USER_PASSWORD=your_test_password_here

# =============================================================================
# MONITORING (Optional)
# =============================================================================
# Sentry for error tracking
# SENTRY_DSN=https://your_sentry_dsn_here

# Application Insights
# APPINSIGHTS_INSTRUMENTATIONKEY=your_key_here